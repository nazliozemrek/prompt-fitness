{
  "manifest_version": 3,
  "name": "Prompt Fitness: AI Footprint",
  "short_name": "Prompt Fitness",
  "version": "1.0.0",
  "description": "Estimates the water and carbon footprint of your AI chats on your device, with tips for more efficient prompts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Fitness",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prompt-fitness@nazliozemrek.github.io"
    }
  }
}
